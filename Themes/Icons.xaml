<!-- Logos vectoriels (nets à toutes les tailles et à tous les DPI). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Logo Windows 11 : quatre carreaux, dégradé bleu continu sur l'ensemble -->
    <DrawingImage x:Key="WindowsLogo">
        <DrawingImage.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Brush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#45C8F7" Offset="0" />
                        <GradientStop Color="#1E90E8" Offset="0.5" />
                        <GradientStop Color="#0B5CC5" Offset="1" />
                    </LinearGradientBrush>
                </GeometryDrawing.Brush>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry Rect="0,0,9.5,9.5" RadiusX="0.6" RadiusY="0.6" />
                        <RectangleGeometry Rect="10.5,0,9.5,9.5" RadiusX="0.6" RadiusY="0.6" />
                        <RectangleGeometry Rect="0,10.5,9.5,9.5" RadiusX="0.6" RadiusY="0.6" />
                        <RectangleGeometry Rect="10.5,10.5,9.5,9.5" RadiusX="0.6" RadiusY="0.6" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Bouclier rouge avec « ! » : fichier potentiellement malveillant -->
    <DrawingImage x:Key="ThreatShield">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M12,1 L21.5,4.6 V11.2 C21.5,16.8 17.6,21.4 12,23 C6.4,21.4 2.5,16.8 2.5,11.2 V4.6 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F87171" Offset="0" />
                            <GradientStop Color="#DC2626" Offset="0.55" />
                            <GradientStop Color="#991B1B" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="10.6,5.6,2.8,9.2" RadiusX="1.4" RadiusY="1.4" />
                            <EllipseGeometry Center="12,18" RadiusX="1.6" RadiusY="1.6" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Bouclier orange avec « ? » : à vérifier -->
    <DrawingImage x:Key="WarnShield">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M12,1 L21.5,4.6 V11.2 C21.5,16.8 17.6,21.4 12,23 C6.4,21.4 2.5,16.8 2.5,11.2 V4.6 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FCD34D" Offset="0" />
                            <GradientStop Color="#F59E0B" Offset="0.55" />
                            <GradientStop Color="#B45309" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="10.6,5.6,2.8,9.2" RadiusX="1.4" RadiusY="1.4" />
                            <EllipseGeometry Center="12,18" RadiusX="1.6" RadiusY="1.6" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Bouclier vert avec coche : rien de suspect -->
    <DrawingImage x:Key="SafeShield">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M12,1 L21.5,4.6 V11.2 C21.5,16.8 17.6,21.4 12,23 C6.4,21.4 2.5,16.8 2.5,11.2 V4.6 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#4ADE80" Offset="0" />
                            <GradientStop Color="#16A34A" Offset="0.6" />
                            <GradientStop Color="#166534" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M7.5,12 L10.8,15.3 L16.8,8.8">
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="2.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Gros triangle danger -->
    <DrawingImage x:Key="DangerTriangle">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M12,2.5 L22.5,20.5 H1.5 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F87171" Offset="0" />
                            <GradientStop Color="#DC2626" Offset="0.6" />
                            <GradientStop Color="#B91C1C" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#DC2626" Thickness="2" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="10.8,8,2.4,7.4" RadiusX="1.2" RadiusY="1.2" />
                            <EllipseGeometry Center="12,17.6" RadiusX="1.4" RadiusY="1.4" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Logo PrimaFiles : un « P » dont la boucle est une loupe, sur fond dégradé bleu → violet -->
    <DrawingImage x:Key="AppLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Fond -->
                <GeometryDrawing Geometry="M56,0 H200 A56,56 0 0 1 256,56 V200 A56,56 0 0 1 200,256 H56 A56,56 0 0 1 0,200 V56 A56,56 0 0 1 56,0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0" />
                            <GradientStop Color="#2563EB" Offset="0.55" />
                            <GradientStop Color="#6D28D9" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- Reflet discret en haut -->
                <GeometryDrawing Geometry="M56,0 H200 A56,56 0 0 1 256,56 V96 C180,124 76,124 0,96 V56 A56,56 0 0 1 56,0 Z">
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="White" Opacity="0.08" />
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- Verre de la loupe -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="White" Opacity="0.2" />
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="140,106" RadiusX="38" RadiusY="38" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Barres de stockage dans le verre -->
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="120,110,10,18" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="135,96,10,32" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="150,86,10,42" RadiusX="2" RadiusY="2" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Jambage du P -->
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="56,40,34,176" RadiusX="10" RadiusY="10" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Boucle du P = monture de la loupe -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="28" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="140,106" RadiusX="52" RadiusY="52" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Manche de la loupe -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FBBF24" Thickness="28" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="186,152" EndPoint="214,182" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
