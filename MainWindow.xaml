<Window x:Class="StorageScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StorageScanner.UI"
        Title="PrimaFiles"
        Icon="Assets/PrimaFiles.ico"
        Width="1440" Height="920" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextBr}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Badges de sécurité : logo Windows = élément système, triangle = ne pas supprimer -->
        <DataTemplate x:Key="SafetyBadges">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding SafetyText}">
                <!-- Fichier potentiellement malveillant : bouclier rouge (suspect) ou orange (à vérifier) -->
                <Image Source="{StaticResource ThreatShield}" Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center"
                       ToolTip="{Binding SuspicionText}" ToolTipService.InitialShowDelay="150"
                       Visibility="{Binding IsSuspectDanger, Converter={StaticResource BoolToVis}}" />
                <Image Source="{StaticResource WarnShield}" Width="15" Height="15" Margin="8,0,0,0" VerticalAlignment="Center"
                       ToolTip="{Binding SuspicionText}" ToolTipService.InitialShowDelay="150"
                       Visibility="{Binding IsSuspectWarning, Converter={StaticResource BoolToVis}}" />
                <Image Source="{StaticResource WindowsLogo}" Width="13" Height="13" Margin="8,0,0,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Margin="6,0,0,0" Foreground="{DynamicResource WarningBr}"
                           Visibility="{Binding IsCritical, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="NameWithBadges">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SafetyBadges}" />
            </StackPanel>
        </DataTemplate>

        <ContextMenu x:Key="FolderMenu" x:Shared="False">
            <MenuItem Header="{ui:L openInExplorer}" Click="OpenInExplorer_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{ui:L copyPath}" Click="CopyPath_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{ui:L properties}" Click="Properties_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{ui:L zoomTreemapHere}" Click="ZoomTreemapHere_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xF0E2;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{ui:L scanThisFolder}" Click="ScanHere_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="FileMenu" x:Shared="False">
            <MenuItem Header="{ui:L showInExplorer}" Click="OpenInExplorer_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{ui:L copyPath}" Click="CopyPath_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{ui:L properties}" Click="Properties_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{ui:L showInTree}" Click="ShowInTree_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{ui:L checkWithAv}" Click="CheckWithAv_Click">
                <MenuItem.Icon><Image Source="{StaticResource ThreatShield}" Width="15" Height="15" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="StaleMenu" x:Shared="False">
            <MenuItem Header="{ui:L openInExplorer}" Click="OpenInExplorer_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{ui:L showInTree}" Click="ShowInTree_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{ui:L copyPath}" Click="CopyPath_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{ui:L properties}" Click="Properties_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="SimpleMenu" x:Shared="False">
            <MenuItem Header="{ui:L showInExplorer}" Click="OpenInExplorer_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{ui:L copyPath}" Click="CopyPath_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{ui:L properties}" Click="Properties_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{ui:L checkWithAv}" Click="CheckWithAv_Click">
                <MenuItem.Icon><Image Source="{StaticResource ThreatShield}" Width="15" Height="15" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="KpiIcon" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="TabIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource WindowBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- Proportions plutôt que hauteurs fixes : tout suit la taille de la fenêtre -->
                <RowDefinition Height="3*" MinHeight="220" />
                <RowDefinition x:Name="SplitterRow" Height="Auto" />
                <RowDefinition x:Name="TreemapRow" Height="2*" MinHeight="0" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- ============ Barre de titre ============ -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="{StaticResource AppLogo}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="PrimaFiles" FontWeight="SemiBold" FontSize="13.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ScanTarget}" Style="{StaticResource Subtle}" Margin="12,0,0,0" MaxWidth="700" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <!-- Mode administrateur : bouton de relance, ou badge si déjà élevé -->
                    <Button Style="{StaticResource TitleTextButton}" Command="{Binding RestartAsAdminCommand}"
                            Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVis}}"
                            ToolTip="{ui:L adminModeTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="13" Foreground="{DynamicResource WarningBr}" Margin="0,0,7,0" />
                            <TextBlock Text="{ui:L adminMode}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Background="{DynamicResource AdminBadgeBg}" CornerRadius="5" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}}"
                            ToolTip="{ui:L adminBadgeTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="12" Foreground="{DynamicResource WarningBr}" Margin="0,0,6,0" />
                            <TextBlock Text="{ui:L adminBadge}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningBr}" />
                        </StackPanel>
                    </Border>
                    <!-- Choix de la langue : Français, English, Español, Deutsch -->
                    <Button x:Name="LanguageButton" Style="{StaticResource TitleTextButton}" Click="LanguageButton_Click" ToolTip="{ui:L language}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding LanguageCode}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Command="{Binding ToggleThemeCommand}" Content="{Binding ThemeGlyph}"
                            FontSize="14" ToolTip="{Binding ThemeTooltip}" />
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource BorderBr}" Margin="4,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{ui:L minimize}" />
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="{ui:L maximize}" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{ui:L close}" />
                </StackPanel>
            </Grid>

            <!-- ============ Barre de commande ============ -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,2,16,0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBox x:Name="PathBox" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}" Padding="34,0,40,0" FontSize="13.5"
                                 Tag="{ui:L pathPlaceholder}"
                                 KeyDown="PathBox_KeyDown" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{DynamicResource SubtleTextBr}"
                                   Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <ToggleButton x:Name="HistoryToggle" Style="{StaticResource IconToggle}" HorizontalAlignment="Right" Margin="0,0,3,0"
                                      Height="28" MinWidth="30" Padding="6,0" BorderThickness="0" Background="Transparent"
                                      ToolTip="{ui:L recentTip}"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=HistoryPopup, Converter={StaticResource Not}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="13" />
                        </ToggleButton>
                        <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=PathBox}" Placement="Bottom" VerticalOffset="4"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               IsOpen="{Binding IsChecked, ElementName=HistoryToggle}">
                            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,12,12" Width="{Binding ActualWidth, ElementName=PathBox}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{ui:L recentUpper}" Style="{StaticResource Subtle}" FontSize="10.5" FontWeight="SemiBold" Margin="10,6,0,4" />
                                    <ListBox x:Name="HistoryList" ItemsSource="{Binding RecentPaths}" BorderThickness="0" Background="Transparent"
                                             ItemContainerStyle="{StaticResource HistoryItem}" MaxHeight="320"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="History_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="12" Foreground="{DynamicResource FaintTextBr}" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseCommand}" ToolTip="{ui:L browseTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0" />
                            <TextBlock Text="{ui:L browse}" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Command="{Binding ScanCommand}" MinWidth="120"
                            Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVis}}" ToolTip="{ui:L scanTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="{ui:L scan}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}" MinWidth="120"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="{ui:L stop}" />
                        </StackPanel>
                    </Button>

                    <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource BorderBr}" Margin="14,4" />

                    <Button Grid.Column="4" Command="{Binding ExportCommand}" Margin="0" ToolTip="{ui:L exportTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" Margin="0,0,8,0" />
                            <TextBlock Text="{ui:L export}" />
                        </StackPanel>
                    </Button>

                    <ToggleButton x:Name="TreemapToggle" Grid.Column="5" Style="{StaticResource IconToggle}" Margin="8,0,0,0" IsChecked="True"
                                  ToolTip="{ui:L toggleTreemapTip}" Checked="TreemapToggle_Changed" Unchecked="TreemapToggle_Changed">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xF0E2;" />
                    </ToggleButton>

                    <ToggleButton x:Name="OptionsToggle" Grid.Column="6" Style="{StaticResource IconToggle}" Margin="8,0,0,0" ToolTip="{ui:L settings}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=OptionsPopup, Converter={StaticResource Not}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                    </ToggleButton>
                    <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=OptionsToggle}" Placement="Bottom" VerticalOffset="6"
                           HorizontalOffset="-300" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           IsOpen="{Binding IsChecked, ElementName=OptionsToggle}">
                        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,12,12" Width="340">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{ui:L settingsTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="70" Height="30" Text="{Binding Threads}" HorizontalContentAlignment="Right" />
                                    <TextBlock Text="{ui:L optThreads}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{ui:L optThreadsHint}" Style="{StaticResource Subtle}" FontSize="11.5" Margin="0,4,0,14" />

                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="70" Height="30" Text="{Binding DupMinSizeMb}" HorizontalContentAlignment="Right" />
                                    <TextBlock Text="{ui:L optDupMin}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{ui:L optDupMinHint}" Style="{StaticResource Subtle}"
                                           FontSize="11.5" Margin="0,4,0,14" TextWrapping="Wrap" />

                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="70" Height="30" Text="{Binding DupThreads}" HorizontalContentAlignment="Right" />
                                    <TextBlock Text="{ui:L optDupThreads}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{ui:L optSaved}" Style="{StaticResource Subtle}" FontSize="11.5" Margin="0,4,0,0" />

                                <Rectangle Height="1" Fill="{DynamicResource BorderBr}" Margin="0,14" />
                                <TextBlock Text="{ui:L shortcuts}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <Grid TextElement.FontSize="12">
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                                            <Setter Property="Margin" Value="0,2" />
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{ui:L kEnterF5}" FontWeight="SemiBold" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{ui:L kbScan}" />
                                    <TextBlock Grid.Row="1" Text="{ui:L kEsc}" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{ui:L kbStop}" />
                                    <TextBlock Grid.Row="2" Text="{ui:L kCtrlF}" FontWeight="SemiBold" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{ui:L kbSearch}" />
                                    <TextBlock Grid.Row="3" Text="{ui:L kCtrlL}" FontWeight="SemiBold" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{ui:L kbPath}" />
                                    <TextBlock Grid.Row="4" Text="{ui:L kCtrlO}" FontWeight="SemiBold" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{ui:L kbBrowse}" />
                                    <TextBlock Grid.Row="5" Text="{ui:L kCtrlE}" FontWeight="SemiBold" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{ui:L kbExport}" />
                                    <TextBlock Grid.Row="6" Text="{ui:L kCtrl17}" FontWeight="SemiBold" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{ui:L kbTabs}" />
                                    <TextBlock Grid.Row="7" Text="{ui:L kDrag}" FontWeight="SemiBold" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{ui:L kbDrag}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Grid.Column="7" Margin="8,0,0,0" Command="{Binding NewScanCommand}" ToolTip="{ui:L homeTip}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============ Indicateurs ============ -->
            <UniformGrid Grid.Row="2" Columns="6" Margin="10,12,10,0"
                         Visibility="{Binding ShowWelcome, Converter={StaticResource InverseBoolToVis}}">
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="14,12">
                    <DockPanel>
                        <Border Style="{DynamicResource KpiIcon}" Background="{DynamicResource KpiBlueBg}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" Foreground="{DynamicResource KpiBlueFg}" FontSize="17" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ui:L kpiSize}" Style="{DynamicResource KpiLabel}" />
                            <TextBlock Text="{Binding KpiSize}" Style="{DynamicResource KpiValue}" />
                            <TextBlock Text="{Binding KpiSizeSub}" Style="{DynamicResource KpiLabel}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="14,12">
                    <DockPanel>
                        <Border Style="{DynamicResource KpiIcon}" Background="{DynamicResource KpiGreenBg}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" Foreground="{DynamicResource KpiGreenFg}" FontSize="17" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ui:L files}" Style="{DynamicResource KpiLabel}" />
                            <TextBlock Text="{Binding KpiFiles}" Style="{DynamicResource KpiValue}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="14,12">
                    <DockPanel>
                        <Border Style="{DynamicResource KpiIcon}" Background="{DynamicResource KpiAmberBg}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{DynamicResource KpiAmberFg}" FontSize="17" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ui:L folders}" Style="{DynamicResource KpiLabel}" />
                            <TextBlock Text="{Binding KpiDirs}" Style="{DynamicResource KpiValue}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="14,12">
                    <DockPanel>
                        <Border Style="{DynamicResource KpiIcon}" Background="{DynamicResource KpiPurpleBg}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE916;" Foreground="{DynamicResource KpiPurpleFg}" FontSize="17" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ui:L kpiDuration}" Style="{DynamicResource KpiLabel}" />
                            <TextBlock Text="{Binding KpiDuration}" Style="{DynamicResource KpiValue}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="14,12">
                    <DockPanel>
                        <Border Style="{DynamicResource KpiIcon}" Background="{DynamicResource KpiRedBg}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xED1A;" Foreground="{DynamicResource KpiRedFg}" FontSize="17" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ui:L inaccessibleFolders}" Style="{DynamicResource KpiLabel}" />
                            <TextBlock Text="{Binding KpiErrors}" Style="{DynamicResource KpiValue}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- Fichiers suspects : cliquable, ouvre l'onglet Suspects -->
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="14,12" Cursor="Hand" MouseLeftButtonUp="SuspectsKpi_Click"
                        ToolTip="{ui:L kpiSuspectsTip}">
                    <DockPanel>
                        <Border Style="{DynamicResource KpiIcon}" Background="{DynamicResource KpiRedBg}">
                            <Image Source="{StaticResource ThreatShield}" Width="20" Height="20" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ui:L kpiSuspects}" Style="{DynamicResource KpiLabel}" />
                            <TextBlock Text="{Binding KpiSuspects}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSuspects}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBr}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- ============ Contenu principal ============ -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="16,12,16,0">
                <Grid>
                    <!-- Accueil -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,36" MaxWidth="1000">
                            <Image Source="{StaticResource AppLogo}" Width="76" Height="76" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25" Color="#2563EB" />
                                </Image.Effect>
                            </Image>
                            <TextBlock Text="PrimaFiles" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBr}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock Text="{ui:L welcomeTitle}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,8" />
                            <TextBlock Text="{ui:L welcomeText}"
                                       Style="{StaticResource Subtle}" FontSize="14" HorizontalAlignment="Center" />

                            <ItemsControl ItemsSource="{Binding Drives}" Margin="0,26,0,0" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource TileButton}" Width="260" Margin="7"
                                                Command="{Binding DataContext.ScanPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Root}" ToolTip="{Binding ToolTip}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="20" Foreground="{DynamicResource AccentBr}" Margin="0,0,12,0" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Kind}" FontSize="11.5" Foreground="{DynamicResource SubtleTextBr}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Margin="0,12,0,8"
                                                             Foreground="{Binding UsedPercent, Converter={StaticResource PercentBrush}, ConverterParameter=disk}" />
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsedText}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{Binding UsedPercent, Converter={StaticResource PercentBrush}, ConverterParameter=disk}" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" FontSize="12" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Subtle}" FontSize="12" HorizontalAlignment="Center" Margin="0,26,0,0" TextWrapping="Wrap" TextAlignment="Center">
                                <Run Text="{ui:L tipBefore}" />
                                <Run FontFamily="{StaticResource IconFont}" Text="&#xE713;" />
                                <Run Text="{ui:L tipAfter}" />
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Analyse en cours -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{ui:L scanning}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ScanTarget}" Style="{StaticResource Subtle}" FontSize="14" HorizontalAlignment="Center"
                                   Margin="0,6,0,22" TextTrimming="CharacterEllipsis" />
                        <ProgressBar IsIndeterminate="{Binding IsScanning}" Height="6" />
                        <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource Subtle}" FontSize="11.5" Margin="0,14,0,0"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        <Button Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="{ui:L stopScan}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Résultats -->
                    <TabControl SelectedIndex="{Binding SelectedTabIndex}" Visibility="{Binding ShowResults, Converter={StaticResource BoolToVis}}">

                        <!-- 0 : Arborescence -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TabIcon}" Text="&#xE8B7;" />
                                    <TextBlock Text="{ui:L tabTree}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7*" MinWidth="420" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="3*" MinWidth="240" />
                                </Grid.ColumnDefinitions>

                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="14,10,14,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{ui:L sortBy}" Style="{StaticResource Subtle}" Margin="0,0,10,0" />
                                            <Border Background="{DynamicResource SegmentBg}" CornerRadius="7" Padding="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource Segment}" Content="{ui:L sortName}"
                                                                 IsChecked="{Binding SortIndex, Converter={StaticResource IntEquals}, ConverterParameter=0}" />
                                                    <RadioButton Style="{StaticResource Segment}" Content="{ui:L size}"
                                                                 IsChecked="{Binding SortIndex, Converter={StaticResource IntEquals}, ConverterParameter=1}" />
                                                    <RadioButton Style="{StaticResource Segment}" Content="{ui:L files}"
                                                                 IsChecked="{Binding SortIndex, Converter={StaticResource IntEquals}, ConverterParameter=2}" />
                                                    <RadioButton Style="{StaticResource Segment}" Content="{ui:L date}"
                                                                 IsChecked="{Binding SortIndex, Converter={StaticResource IntEquals}, ConverterParameter=3}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <!-- Recherche d'un dossier par son nom (Ctrl+F, Entrée = suivant, Maj+Entrée = précédent) -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    ToolTip="{ui:L treeHint}">
                                            <TextBlock Text="{Binding FolderSearchStatus}" Style="{StaticResource Subtle}" FontSize="11.5"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Grid Width="230">
                                                <TextBox x:Name="FolderSearchBox" Height="30" Padding="30,0,8,0"
                                                         Text="{Binding FolderSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="{ui:L searchPlaceholder}" KeyDown="FolderSearchBox_KeyDown" />
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Foreground="{DynamicResource SubtleTextBr}"
                                                           Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                            </Grid>
                                            <Button Margin="4,0,0,0" Height="30" Padding="8,0" Command="{Binding FindPreviousFolderCommand}" ToolTip="{ui:L prevTip}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="11" />
                                            </Button>
                                            <Button Margin="4,0,0,0" Height="30" Padding="8,0" Command="{Binding FindNextFolderCommand}" ToolTip="{ui:L nextTip}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid x:Name="TreeGrid"
                                              ItemsSource="{Binding Tree.Rows}"
                                              SelectedItem="{Binding SelectedTreeRow}"
                                              ContextMenu="{StaticResource FolderMenu}"
                                              Sorting="TreeGrid_Sorting"
                                              MouseDoubleClick="TreeGrid_MouseDoubleClick"
                                              PreviewKeyDown="TreeGrid_PreviewKeyDown">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Style.Triggers>
                                                    <!-- Mise en évidence après un clic sur la carte des volumes -->
                                                    <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource RowFlashBr}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="{ui:L name}" Width="*" MinWidth="240" SortMemberPath="Name">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" ToolTip="{Binding ToolTip}">
                                                            <Button Style="{StaticResource ExpanderButton}" Content="{Binding ExpanderGlyph}" Click="Expander_Click" />
                                                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="15" Text="{Binding Icon}" Foreground="{Binding IconBrush}"
                                                                       VerticalAlignment="Center" Margin="4,0,8,0" />
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SafetyBadges}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{ui:L size}" Width="90" SortMemberPath="Size" FontWeight="SemiBold"
                                                                Binding="{Binding Size, Converter={StaticResource Bytes}}" ElementStyle="{StaticResource RightCell}" />
                                            <DataGridTemplateColumn Header="{ui:L pctParent}" Width="160" SortMemberPath="Size">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Width="48" TextAlignment="Right"
                                                                       FontSize="11.5" Foreground="{DynamicResource SubtleTextBr}" VerticalAlignment="Center" />
                                                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"
                                                                         Foreground="{Binding PercentBrush}" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{ui:L files}" Width="90" SortMemberPath="Files"
                                                                Binding="{Binding Files, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" />
                                            <DataGridTextColumn Header="{ui:L folders}" Width="85" SortMemberPath="Files"
                                                                Binding="{Binding Dirs, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" />
                                            <DataGridTextColumn Header="{ui:L modified}" Width="130" SortMemberPath="ModifiedUtc"
                                                                Binding="{Binding ModifiedUtc, Converter={StaticResource LocalDate}}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>

                                <GridSplitter Grid.Column="1" Style="{StaticResource VSplitter}" />

                                <DockPanel Grid.Column="2">
                                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" Foreground="{DynamicResource FilesIconBr}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding FolderFilesTitle}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding FolderFilesHeader}" Style="{StaticResource Subtle}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding FolderFiles}" ContextMenu="{StaticResource SimpleMenu}">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="{ui:L name}" Width="*" SortMemberPath="Name" CellTemplate="{StaticResource NameWithBadges}" />
                                            <DataGridTextColumn Header="{ui:L size}" Width="80" SortMemberPath="Size"
                                                                Binding="{Binding Size, Converter={StaticResource Bytes}}" ElementStyle="{StaticResource RightCell}" />
                                            <DataGridTextColumn Header="{ui:L modified}" Width="138" SortMemberPath="LastWriteUtc"
                                                                Binding="{Binding LastWriteUtc, Converter={StaticResource LocalDate}}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>
                        </TabItem>

                        <!-- 1 : Gros fichiers -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TabIcon}" Text="&#xE7C3;" />
                                    <TextBlock Text="{ui:L tabBigFiles}" />
                                </StackPanel>
                            </TabItem.Header>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding TopFilesHeader}" Style="{StaticResource Subtle}" Margin="14,12,14,6" />
                                <DataGrid ItemsSource="{Binding TopFiles}" ContextMenu="{StaticResource FileMenu}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{ui:L name}" Width="280" SortMemberPath="Name" CellTemplate="{StaticResource NameWithBadges}" />
                                        <DataGridTextColumn Header="{ui:L size}" Width="95" SortMemberPath="Size" FontWeight="SemiBold"
                                                            Binding="{Binding Size, Converter={StaticResource Bytes}}" ElementStyle="{StaticResource RightCell}" />
                                        <DataGridTextColumn Header="{ui:L type}" Width="75" Binding="{Binding Extension}" />
                                        <DataGridTextColumn Header="{ui:L modified}" Width="130" SortMemberPath="LastWriteUtc"
                                                            Binding="{Binding LastWriteUtc, Converter={StaticResource LocalDate}}" />
                                        <DataGridTextColumn Header="{ui:L location}" Width="*" Binding="{Binding DirectoryPath}" Foreground="{DynamicResource SubtleTextBr}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <!-- 2 : Types de fichiers -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TabIcon}" Text="&#xE8FD;" />
                                    <TextBlock Text="{ui:L tabTypes}" />
                                </StackPanel>
                            </TabItem.Header>
                            <DataGrid ItemsSource="{Binding Extensions}" Margin="0,6,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{ui:L extension}" Width="170" Binding="{Binding Extension}" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="{ui:L files}" Width="100" SortMemberPath="Count"
                                                        Binding="{Binding Count, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="{ui:L size}" Width="100" SortMemberPath="Size"
                                                        Binding="{Binding Size, Converter={StaticResource Bytes}}" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTemplateColumn Header="{ui:L shareOfTotal}" Width="280" SortMemberPath="Percent">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Percent, StringFormat={}{0:0.0} %}" Width="54" TextAlignment="Right"
                                                               FontSize="11.5" Foreground="{DynamicResource SubtleTextBr}" VerticalAlignment="Center" />
                                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center"
                                                                 Foreground="{Binding Percent, Converter={StaticResource PercentBrush}}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{ui:L avgSize}" Width="120" SortMemberPath="AverageSize"
                                                        Binding="{Binding AverageSize, Converter={StaticResource Bytes}}" ElementStyle="{StaticResource RightCell}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- 3 : Doublons -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TabIcon}" Text="&#xE8C8;" />
                                    <TextBlock Text="{ui:L tabDuplicates}" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="100" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="80" />
                                </Grid.RowDefinitions>

                                <Grid Margin="14,12,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource AccentButton}" Command="{Binding FindDuplicatesCommand}" Margin="0"
                                                Visibility="{Binding IsFindingDuplicates, Converter={StaticResource InverseBoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Margin="0,0,8,0" />
                                                <TextBlock Text="{ui:L findDuplicates}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource DangerButton}" Command="{Binding CancelDuplicatesCommand}" Margin="0"
                                                Visibility="{Binding IsFindingDuplicates, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" Margin="0,0,8,0" />
                                                <TextBlock Text="{ui:L cancelSearch}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DupStatus}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{Binding DupPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,6,0,0"
                                                     Visibility="{Binding IsFindingDuplicates, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{ui:L dupMethod}"
                                                   Style="{StaticResource Subtle}" FontSize="11.5" Margin="0,3,0,0"
                                                   Visibility="{Binding IsFindingDuplicates, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>
                                </Grid>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding Duplicates}" SelectedItem="{Binding SelectedDuplicate}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{ui:L file}" Width="*" Binding="{Binding FirstName}" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="{ui:L unitSize}" Width="110" SortMemberPath="Size"
                                                            Binding="{Binding Size, Converter={StaticResource Bytes}}" ElementStyle="{StaticResource RightCell}" />
                                        <DataGridTextColumn Header="{ui:L copies}" Width="80" SortMemberPath="Count"
                                                            Binding="{Binding Count, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" />
                                        <DataGridTextColumn Header="{ui:L recoverable}" Width="140" SortMemberPath="WastedSize" Foreground="{DynamicResource DangerBr}" FontWeight="SemiBold"
                                                            Binding="{Binding WastedSize, Converter={StaticResource Bytes}}" ElementStyle="{StaticResource RightCell}" />
                                        <DataGridTextColumn Header="{ui:L sha256}" Width="160" Binding="{Binding ShortHash}" FontFamily="Consolas"
                                                            Foreground="{DynamicResource SubtleTextBr}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <GridSplitter Grid.Row="2" Style="{StaticResource HSplitter}" />

                                <DataGrid Grid.Row="3" ItemsSource="{Binding SelectedDuplicate.Files}" ContextMenu="{StaticResource FileMenu}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{ui:L copyLocations}" Width="*" SortMemberPath="FullPath">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FullPath}" VerticalAlignment="Center" />
                                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SafetyBadges}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{ui:L modified}" Width="140" SortMemberPath="LastWriteUtc"
                                                            Binding="{Binding LastWriteUtc, Converter={StaticResource LocalDate}}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- 4 : Fichiers suspects -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{StaticResource ThreatShield}" Width="14" Height="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding SuspectsHeader}" />
                                </StackPanel>
                            </TabItem.Header>
                            <DockPanel>
                                <!-- Bandeau d'alerte -->
                                <Border DockPanel.Dock="Top" Margin="14,12,14,8" CornerRadius="10" Padding="18,14"
                                        Background="{DynamicResource DangerSoftBr}" BorderBrush="{DynamicResource DangerBr}" BorderThickness="1"
                                        Visibility="{Binding HasSuspects, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{StaticResource DangerTriangle}" Width="54" Height="54" VerticalAlignment="Top" Margin="0,0,16,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{ui:L suspectsBannerTitle}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource DangerBr}" />
                                            <TextBlock Text="{Binding SuspectsSummary}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            <TextBlock Text="{ui:L suspectsBannerText}"
                                                       FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Button Style="{StaticResource DangerButton}" Command="{Binding CheckAllSuspectsCommand}" MinWidth="230"
                                                    Visibility="{Binding IsAvChecking, Converter={StaticResource InverseBoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{StaticResource ThreatShield}" Width="15" Height="15" Margin="0,0,8,0" />
                                                    <TextBlock Text="{ui:L checkAll}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding CancelAvCommand}" MinWidth="230"
                                                    Visibility="{Binding IsAvChecking, Converter={StaticResource BoolToVis}}" Content="{ui:L stopCheck}" />
                                            <Button Command="{Binding CheckSuspectCommand}" MinWidth="230" Margin="0,6,0,0" Content="{ui:L checkSelected}" />
                                            <TextBlock Text="{Binding AvName}" Style="{StaticResource Subtle}" FontSize="11.5" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Aucun suspect -->
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0"
                                            Visibility="{Binding NoSuspects, Converter={StaticResource BoolToVis}}">
                                    <Image Source="{StaticResource SafeShield}" Width="46" Height="46" Margin="0,0,14,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{ui:L noSuspectsTitle}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{ui:L noSuspectsText}"
                                                   Style="{StaticResource Subtle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <DataGrid ItemsSource="{Binding Suspects}" SelectedItem="{Binding SelectedSuspect}" ContextMenu="{StaticResource FileMenu}"
                                          Visibility="{Binding HasSuspects, Converter={StaticResource BoolToVis}}" RowHeight="32">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{ui:L level}" Width="120" SortMemberPath="IsDanger">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Width="18" Height="18" Margin="0,0,8,0">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Source" Value="{StaticResource WarnShield}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                                                            <Setter Property="Source" Value="{StaticResource ThreatShield}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <TextBlock Text="{Binding LevelText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{ui:L file}" Width="220" Binding="{Binding Name}" FontWeight="SemiBold" />
                                        <DataGridTemplateColumn Header="{ui:L why}" Width="*" SortMemberPath="ReasonsText">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ReasonsText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReasonsText}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{ui:L antivirus}" Width="200" SortMemberPath="AvText">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AvText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{Binding AvBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AvBrush}" Value="{x:Null}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBr}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{ui:L size}" Width="85" SortMemberPath="Size"
                                                            Binding="{Binding Size, Converter={StaticResource Bytes}}" ElementStyle="{StaticResource RightCell}" />
                                        <DataGridTextColumn Header="{ui:L modified}" Width="130" SortMemberPath="LastWriteUtc"
                                                            Binding="{Binding LastWriteUtc, Converter={StaticResource LocalDate}}" />
                                        <DataGridTextColumn Header="{ui:L location}" Width="260" Binding="{Binding DirectoryPath}" Foreground="{DynamicResource SubtleTextBr}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <!-- 5 : Erreurs -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TabIcon}" Text="&#xED1A;" />
                                    <TextBlock Text="{Binding ErrorsHeader}" />
                                </StackPanel>
                            </TabItem.Header>
                            <DataGrid ItemsSource="{Binding Errors}" ContextMenu="{StaticResource SimpleMenu}" Margin="0,6,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{ui:L path}" Width="2*" Binding="{Binding Path}" />
                                    <DataGridTextColumn Header="{ui:L error}" Width="*" Binding="{Binding Message}" Foreground="{DynamicResource SubtleTextBr}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- 6 : Dossiers inactifs -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TabIcon}" Text="&#xE81C;" />
                                    <TextBlock Text="{ui:L tabStale}" />
                                </StackPanel>
                            </TabItem.Header>
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="14,10,14,6">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Text="{ui:L staleLabel}" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ComboBox ItemsSource="{Binding StaleYearChoices}" SelectedItem="{Binding StaleYears}" Width="70" Height="30"
                                                  VerticalContentAlignment="Center" />
                                        <TextBlock Text="{ui:L years}" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="8,0,16,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StaleSummary}" Style="{StaticResource Subtle}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StaleSummary}" />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding StaleFolders}" ContextMenu="{StaticResource StaleMenu}" MouseDoubleClick="StaleGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{ui:L folder}" Width="220" Binding="{Binding Name}" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="{ui:L size}" Width="95" SortMemberPath="Size"
                                                            Binding="{Binding Size, Converter={StaticResource Bytes}}" ElementStyle="{StaticResource RightCell}" />
                                        <DataGridTextColumn Header="{ui:L files}" Width="85" Binding="{Binding Files, StringFormat=N0}" ElementStyle="{StaticResource RightCell}" />
                                        <DataGridTextColumn Header="{ui:L lastModified}" Width="150" SortMemberPath="NewestUtc"
                                                            Binding="{Binding NewestUtc, Converter={StaticResource LocalDate}}" />
                                        <DataGridTextColumn Header="{ui:L location}" Width="*" Binding="{Binding FullPath}" Foreground="{DynamicResource SubtleTextBr}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- ============ Carte des volumes ============ -->
            <GridSplitter x:Name="TreemapSplitter" Grid.Row="4" Style="{StaticResource HSplitter}" />

            <Border x:Name="TreemapCard" Grid.Row="5" Style="{StaticResource Card}" Margin="16,0,16,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,10,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xF0E2;" Foreground="{DynamicResource AccentBr}" Margin="0,0,8,0" />
                            <TextBlock Text="{ui:L treemapTitle}" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding FocusPath, ElementName=Treemap}" Style="{StaticResource Subtle}" Margin="14,0" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Click="ZoomOut_Click" IsEnabled="{Binding CanZoomOut, ElementName=Treemap}" ToolTip="{ui:L upTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{ui:L up}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="ZoomRoot_Click" IsEnabled="{Binding CanZoomOut, ElementName=Treemap}" ToolTip="{ui:L rootTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{ui:L root}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Bottom" Margin="16,6,16,10" FontSize="12" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding HoverInfo, ElementName=Treemap}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBr}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HoverInfo, ElementName=Treemap}" Value="">
                                        <Setter Property="Text" Value="{ui:L treemapHint}" />
                                        <Setter Property="Foreground" Value="{DynamicResource FaintTextBr}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Legend, ElementName=Treemap}" Margin="16,8,16,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                                    <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Margin="6,0,5,0" FontSize="12" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Subtle}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:TreemapView x:Name="Treemap" Margin="10,0"
                                    Root="{Binding TreemapRoot}"
                                    SelectedNode="{Binding SelectedNode, Mode=OneWay}" />
                </DockPanel>
            </Border>

            <!-- ============ Barre d'état ============ -->
            <Grid Grid.Row="6" Margin="20,0">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Subtle}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,160,0" />
                <TextBlock Text="{Binding AppVersionText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource FaintTextBr}" />
            </Grid>
        </Grid>
    </Border>
</Window>
