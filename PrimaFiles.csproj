<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PrimaFiles.ico</ApplicationIcon>
    <AssemblyName>PrimaFiles</AssemblyName>
    <RootNamespace>StorageScanner</RootNamespace>

    <!-- Informations de version visibles dans Propriétés > Détails : un exécutable bien identifié
         est mieux considéré par les antivirus et SmartScreen qu'un binaire anonyme. -->
    <Product>PrimaFiles</Product>
    <AssemblyTitle>PrimaFiles - Analyse de l'espace disque</AssemblyTitle>
    <Description>Analyse de l'occupation des disques et partages réseau (lecture seule)</Description>
    <Company>Primatoria</Company>
    <Authors>Primatoria</Authors>
    <Copyright>© 2026 Primatoria</Copyright>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>

    <!-- Build reproductible, sans chemins locaux embarqués -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=PrimaFiles</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Analyse de sécurité du code à la compilation -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Default</AnalysisMode>

    <!-- GC concurrent + server : meilleur débit d'allocation pendant les scans multithread -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\PrimaFiles.ico" />
  </ItemGroup>

</Project>
