<Application x:Class="StorageScanner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:StorageScanner.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] = palette active, remplacée à chaud par ThemeManager (Light.xaml / Dark.xaml) -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ui:BytesConverter x:Key="Bytes" />
            <ui:LocalDateConverter x:Key="LocalDate" />
            <ui:BoolToVisibilityConverter x:Key="BoolToVis" />
            <ui:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <ui:NotConverter x:Key="Not" />
            <ui:IntEqualsConverter x:Key="IntEquals" />
            <ui:PercentToBrushConverter x:Key="PercentBrush" />

            <Style x:Key="RightCell" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <Style x:Key="ExpanderButton" TargetType="Button">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="9" />
                <Setter Property="Foreground" Value="{DynamicResource SubtleTextBr}" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ExpanderHoverBr}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
